{
  "name": "@dloizides/prompt-to-config",
  "version": "0.0.0",
  "description": "Turn a free-text prompt into a validated config object: keyword table, sentence-embedding presets and a grammar-constrained in-browser LLM, with gap fill.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openmindednewby/prompt-to-config.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "rimraf dist && tsup",
    "test": "jest",
    "test:release": "jest",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.eslint.json",
    "prepublishOnly": "npm run build && npm run test:release"
  },
  "peerDependencies": {
    "@dloizides/llm-run": "^0.4.1"
  },
  "devDependencies": {
    "@dloizides/llm-run": "^0.4.1",
    "@wllama/wllama": "3.6.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jest": "^30.0.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
